# Database
# Runtime URL: use the Neon pooled connection string.
DATABASE_URL="PUT_YOUR_NEON_POOLED_CONNECTION_STRING_HERE"

# Prisma CLI URL: use the Neon direct, non-pooler connection string.
DIRECT_URL="PUT_YOUR_NEON_DIRECT_CONNECTION_STRING_HERE"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication
AUTH_SECRET="GENERATE_A_LONG_RANDOM_VALUE"
AUTH_GOOGLE_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
AUTH_GOOGLE_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
AUTH_GITHUB_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
AUTH_GITHUB_SECRET="YOUR_GITHUB_OAUTH_CLIENT_SECRET"
# Only this email may bootstrap the first TEAM_ADMIN account.
AUTH_ADMIN_EMAIL="admin@example.com"

# Vercel Blob - create a public Blob store and use its local-development token.
# On Vercel, connect the store to the project. OIDC and BLOB_STORE_ID are injected automatically.
BLOB_READ_WRITE_TOKEN="PUT_YOUR_VERCEL_BLOB_READ_WRITE_TOKEN_HERE"

# Email provider - exact variables depend on provider
EMAIL_API_KEY=""
EMAIL_FROM=""
